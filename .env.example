# Google OAuth "Web application" client id (Phase 5)
VITE_GOOGLE_CLIENT_ID=
# Google API key restricted to the Picker API (Phase 5)
VITE_GOOGLE_API_KEY=
# Google Cloud project number, used by the Picker (Phase 5)
VITE_GOOGLE_APP_ID=
# Public URL of the deployed app, sent to OpenRouter as HTTP-Referer
VITE_APP_URL=http://localhost:5173

# Live collaboration signalling (PeerJS). Leave empty for the public PeerJS cloud.
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
# JSON array of RTCIceServer, e.g. [{"urls":"turn:turn.example.com","username":"u","credential":"p"}]
VITE_PEER_ICE=
