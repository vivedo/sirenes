# Google OAuth "Web application" client id (Phase 5)
VITE_GOOGLE_CLIENT_ID=
# Google API key restricted to the Picker API (Phase 5)
VITE_GOOGLE_API_KEY=
# Google Cloud project number, used by the Picker (Phase 5)
VITE_GOOGLE_APP_ID=
# Public URL of the deployed app, sent to OpenRouter as HTTP-Referer
VITE_APP_URL=http://localhost:5173
